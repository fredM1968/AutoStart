<Window x:Class="NINA.Plugin.AutoStart.AutoStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoStart" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Background="#FF2F3A3D" Foreground="#FFE8E8E8"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Interrupteur ON / OFF -->
        <Style x:Key="OnOffToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="110" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="20" Background="#FF5A2A2A" BorderBrush="#FF3C4A4E" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="Label" Text="OFF" FontSize="16" FontWeight="Bold" Foreground="#FFE8E8E8"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0" />
                                <Ellipse x:Name="Knob" Width="30" Height="30" Fill="#FFE8E8E8"
                                         HorizontalAlignment="Left" Margin="5,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF2E7D32" />
                                <Setter TargetName="Label" Property="Text" Value="ON" />
                                <Setter TargetName="Label" Property="HorizontalAlignment" Value="Left" />
                                <Setter TargetName="Label" Property="Margin" Value="18,0,0,0" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,5,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FFE8E8E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="BorderBrush" Value="#FF3C4A4E" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">

        <!-- 1. Interrupteur -->
        <GroupBox Header="Démarrage automatique">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource OnOffToggle}"
                              IsChecked="{Binding IsOn, Mode=OneWay}" Click="Toggle_Click"
                              ToolTip="ON : NINA s'ouvre à l'ouverture de session Windows et lance la séquence choisie" />
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Lancer NINA au démarrage du PC" FontWeight="SemiBold" />
                    <TextBlock Text="puis exécuter la séquence ci-dessous" Opacity="0.75" />
                </StackPanel>
            </DockPanel>
        </GroupBox>

        <!-- 2. Séquence -->
        <GroupBox Header="Séquence à lancer">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Padding="14,4" Content="Choisir la séquence…" Margin="8,0,0,0" Click="Choose_Click"
                            ToolTip="Séquence avancée (.json) ou séquence simple : une cible (.xml) ou un ensemble de cibles (.ninaTargetSet)" />
                    <Button DockPanel.Dock="Right" Padding="10,4" Content="Retirer" Margin="8,0,0,0" Click="Clear_Click" />
                    <TextBox Text="{Binding SequencePath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding SequenceKindText}" Opacity="0.85" />
            </StackPanel>
        </GroupBox>

        <!-- 3. Options -->
        <GroupBox Header="Options">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Padding="10,4" Content="Utiliser le profil actif" Click="Profile_Click" />
                    <TextBlock Text="{Binding ProfileText}" VerticalAlignment="Center" />
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding ConnectEquipment}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Connecter tout le matériel avant de lancer la séquence" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Compte à rebours avant le lancement (s) :" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    <TextBlock Text="  (0 = immédiat ; annulable pendant l'attente)" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 4. Alimentation du matériel -->
        <GroupBox Header="Alimentation du matériel (prise connectée)">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource OnOffToggle}"
                                  IsChecked="{Binding PowerEnabled, Mode=OneWay}" Click="PowerToggle_Click"
                                  ToolTip="ON : la prise est coupée à la fin de chaque séquence (et allumée au lancement automatique si l'option est cochée)" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Couper l'alimentation à la fin de la séquence" FontWeight="SemiBold" />
                        <TextBlock Text="séquence simple ou avancée, lancée à la main ou par AutoStart" Opacity="0.75" />
                    </StackPanel>
                </DockPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Prise :" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                              ItemsSource="{Binding Brands}" DisplayMemberPath="DisplayName" SelectedValuePath="Brand"
                              SelectedValue="{Binding PlugBrand}" />

                    <TextBlock Grid.Row="1" Text="Adresse IP :" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" VerticalContentAlignment="Center"
                             Text="{Binding PlugAddress, UpdateSourceTrigger=LostFocus}" ToolTip="Exemple : 192.168.1.147" />
                    <Button x:Name="ScanButton" Grid.Row="1" Grid.Column="2" Margin="8,0,0,6" Padding="18,4" Content="SCAN"
                            Click="Scan_Click" ToolTip="Cherche les prises sur le réseau et renseigne l'adresse IP" />

                    <ComboBox x:Name="FoundList" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                              Visibility="Collapsed" SelectionChanged="FoundList_SelectionChanged"
                              ToolTip="Plusieurs prises trouvées : choisis celle du matériel" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <Button x:Name="OnButton" Padding="14,4" Content="Allumer" Margin="0,0,8,0" Click="On_Click" />
                        <Button x:Name="OffButton" Padding="14,4" Content="Éteindre" Margin="0,0,12,0" Click="Off_Click" />
                        <TextBlock Text="{Binding PlugStateText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                    </StackPanel>
                </Grid>

                <DockPanel Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding PowerOnAtStartup}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Allumer la prise au lancement automatique, avant de connecter le matériel" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding DisconnectBeforePowerOff}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Déconnecter le matériel dans NINA avant de couper" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding PowerOffOnlyIfCompleted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="Ne pas couper si la séquence a été arrêtée à la main" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Compte à rebours avant la coupure (s) :" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding PowerOffDelayText, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                    <TextBlock Text="  (annulable)" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- État -->
        <Border Background="#FF263033" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
        </Border>

        <DockPanel>
            <Button DockPanel.Dock="Right" Padding="24,4" MinWidth="100" Content="Fermer" Click="Close_Click" />
            <Button HorizontalAlignment="Left" Padding="14,4" Content="Tester maintenant"
                    Click="Test_Click" ToolTip="Déroule la procédure tout de suite (compte à rebours, connexion, séquence) sans redémarrer le PC" />
        </DockPanel>
    </StackPanel>
</Window>
