<ResourceDictionary
    x:Class="NINA.Plugin.AutoStart.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Affiché dans Options > Plugins > AutoStart. La clé doit être "<nom du plugin>_Options" ; DataContext = AutoStartPlugin. -->
    <DataTemplate x:Key="AutoStart_Options">
        <StackPanel Orientation="Vertical" Margin="0,5,0,0">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Lance NINA au démarrage du PC et exécute automatiquement une séquence simple ou avancée." />
            <Button HorizontalAlignment="Left" Padding="20,6" Content="Ouvrir la fenêtre AutoStart" Click="OpenWindow_Click" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
