<Window x:Class="NINA.Plugin.AutoStart.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Équipements à connecter" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Background="#FF2F3A3D" Foreground="#FFE8E8E8" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.85"
                   Text="Seuls les équipements sur ON sont connectés avant le lancement de la séquence. Entre parenthèses : l'appareil choisi dans le profil NINA." />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,14">
            <Button Padding="10,4" Margin="0,0,8,0" Content="Selon le profil" Click="Profile_Click"
                    ToolTip="Coche les types pour lesquels un appareil est choisi dans le profil NINA" />
            <Button Padding="10,4" Content="Équipements connectés maintenant" Click="Connected_Click"
                    ToolTip="Coche exactement ce qui est connecté en ce moment dans NINA" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Padding="24,4" MinWidth="90" Margin="0,0,8,0" Content="OK" IsDefault="True" Click="Ok_Click" />
            <Button Padding="24,4" MinWidth="90" Content="Annuler" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
